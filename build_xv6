#!/bin/bash

set -e

REPO_URL="https://github.com/kamisori-daijin/xv6-riscv.git"
DIR_NAME="xv6-riscv"

echo "=== 1. check directory ==="
if [ ! -d "$DIR_NAME" ]; then
    echo "リポジトリをクローンします..."
    git clone "$REPO_URL"
else
    echo " ${DIR_NAME} already exits"
fi

cd "$DIR_NAME"


echo "=== 2. build xv6 ==="
make 
make fs.img

echo "=== 3. generate .inc ==="
# convert fs.img
if [ -f "fs.img" ]; then
    xxd -i fs.img | sed 's/unsigned char/const unsigned char/' > fs_img.inc
    echo "Created fs_img.inc"
else
    echo "fs.img is not found"
    exit 1
fi

# convert kernel
if [ -f "kernel/kernel" ]; then
    riscv64-unknown-elf-objcopy -O binary kernel/kernel kernel.bin
    xxd -i kernel.bin | sed 's/unsigned char/const unsigned char/' > kernel.inc
    echo "Generated kernel.inc"
else
    echo "Kernel is not found at kernel/kernel"
    exit 1
fi

echo "=== complete ==="
ls -l fs_img.inc kernel.inc

